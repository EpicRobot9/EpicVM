diff --git a/src/MultiSeat.Service/Accounts/AccountManager.cs b/src/MultiSeat.Service/Accounts/AccountManager.cs
index a0a5ae4..082c9ce 100644
--- a/src/MultiSeat.Service/Accounts/AccountManager.cs
+++ b/src/MultiSeat.Service/Accounts/AccountManager.cs
@@ -104,6 +104,12 @@ public sealed class AccountManager
     public string? GetCredential(string username) =>
         _credentials.GetValueOrDefault(username);
 
+    /// <summary>Return a credential only for an account created by MultiSeat.</summary>
+    public string? GetManagedCredential(string username) =>
+        _managedAccounts.TryGetValue(username, out var account) && account.IsManaged
+            ? _credentials.GetValueOrDefault(username)
+            : null;
+
     /// <summary>
     /// Create a new Windows local account for a MultiSeat seat.
     /// </summary>
diff --git a/src/MultiSeat.Service/Api/AccountEndpoints.cs b/src/MultiSeat.Service/Api/AccountEndpoints.cs
index be782a7..4d91f35 100644
--- a/src/MultiSeat.Service/Api/AccountEndpoints.cs
+++ b/src/MultiSeat.Service/Api/AccountEndpoints.cs
@@ -56,6 +56,20 @@ public static class AccountEndpoints
                 return ApiErrors.ToResult(ex);
             }
         });
+
+        // The API is authenticated and bound to loopback on EpicVM hosts. Do not
+        // include credentials in account lists, URLs, logs, or cacheable reads.
+        group.MapPost("/{username}/credential/reveal", (string username, AccountManager mgr, HttpContext context) =>
+        {
+            context.Response.Headers.CacheControl = "no-store";
+            context.Response.Headers.Pragma = "no-cache";
+            if (!ApiInputValidation.IsValidAccountName(username))
+                return ApiInputValidation.AccountNameError();
+            var credential = mgr.GetManagedCredential(username);
+            return credential is null
+                ? Results.NotFound()
+                : Results.Ok(new { password = credential });
+        });
     }
 }
 
